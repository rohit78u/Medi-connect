# General Settings
PROJECT_NAME="MediConnect AI"
ENVIRONMENT="development"
DEBUG=True
API_V1_STR="/api/v1"

# Security & JWT
SECRET_KEY="CHANGE_THIS_IN_PRODUCTION_TO_A_SECURE_64_CHAR_HEX_STRING"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database (SQLite for zero-config local dev, PostgreSQL for production)
DATABASE_URI="sqlite+aiosqlite:///./mediconnect.db"

# Redis & Celery
REDIS_HOST="localhost"
REDIS_PORT=6379
CELERY_BROKER_URL="redis://localhost:6379/0"
CELERY_RESULT_BACKEND="redis://localhost:6379/0"

# CORS
BACKEND_CORS_ORIGINS=["*"]

# Google Gemini AI API
GEMINI_API_KEY=""
