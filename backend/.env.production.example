PROJECT_NAME="MediConnect AI"
ENVIRONMENT="production"
DEBUG=False
API_V1_STR="/api/v1"
SECRET_KEY="REPLACE_WITH_A_LONG_RANDOM_SECRET"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

POSTGRES_SERVER=db
POSTGRES_PORT=5432
POSTGRES_USER="REPLACE_WITH_DB_USER"
POSTGRES_PASSWORD="REPLACE_WITH_DB_PASSWORD"
POSTGRES_DB="mediconnect_db"
DATABASE_URI="postgresql+asyncpg://REPLACE_WITH_DB_USER:REPLACE_WITH_DB_PASSWORD@db:5432/mediconnect_db"

REDIS_HOST=redis
REDIS_PORT=6379
CELERY_BROKER_URL="redis://redis:6379/0"
CELERY_RESULT_BACKEND="redis://redis:6379/0"

BACKEND_CORS_ORIGINS=["https://YOUR_FRONTEND_DOMAIN"]
GEMINI_API_KEY="REPLACE_WITH_GEMINI_KEY"
RAZORPAY_KEY_ID="REPLACE_WITH_RAZORPAY_KEY_ID"
RAZORPAY_KEY_SECRET="REPLACE_WITH_RAZORPAY_SECRET"
MEDICAL_DOCUMENT_STORAGE="/app/storage/medical_documents"
